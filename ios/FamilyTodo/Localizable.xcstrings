    "Wyświetlacz e-papierowy (ESP32-S3) budujesz sam według otwartej instrukcji. Aplikacja nie wysyła danych do internetu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You build the e-paper display (ESP32-S3) yourself from the open-source instructions. The app sends no data to the internet."
          }
        }
      }
    },
