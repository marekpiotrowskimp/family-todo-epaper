        }
      }
    },
    "Zeskanuj aparatem iPhone'a kod QR klucza (z komputera, na którym zbudowano wyświetlacz, albo z ustawień aplikacji domownika) lub wklej klucz. Bez klucza aplikacja działa jako lista na tym telefonie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the key's QR code with the iPhone camera (from the computer the display was built on, or from a family member's app settings) or paste the key. Without a key the app works as a list on this phone."
          }
        }
      }
    },
